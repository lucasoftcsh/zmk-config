//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define default_layer    0
#define num_layer        1
#define fn_layer         2
#define nav_layer        3
#define mouse_layer      4
#define sym_layer        5
/ {
    behaviors {
        // ----- Tap Dance -----
        td_space_ctrl: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "SPACE / CTRL";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SPACE>, <&kp LCTRL>;
        };

        td_a_fn: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "A / MO(3)";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp A>, <&mo 3>;
        };

        td_o_fn: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "O / MO(1)";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp O>, <&mo 1>;
        };

        td_shift: tap_dance_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT(-/1)";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LS>, <&mo 1>;
        };

        // ----- Macros -----
        macro_left: macro_0 {
            compatible = "zmk,behavior-macro";
            label = "Shift+Left";
            #binding-cells = <0>;
            bindings = <&kp LS &kp LEFT>;
        };

        macro_right: macro_1 {
            compatible = "zmk,behavior-macro";
            label = "Shift+Right";
            #binding-cells = <0>;
            bindings = <&kp LS &kp RIGHT>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 3>; // W + F
            bindings = <&kp ESC>;
        };
        combo_tab {
            timeout-ms = <50>;
            key-positions = <11 12>; // X + C
            bindings = <&kp TAB>;
        };
        combo_bspc {
            timeout-ms = <50>;
            key-positions = <10 17>; // Z + U
            bindings = <&kp BSPC>;
        };
        combo_enter {
            timeout-ms = <50>;
            key-positions = <28 29>; // , + .
            bindings = <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ----- Layer 0: Colemak-DH -----
        default_layer {
            bindings = <
                &kp Q    &kp W     &kp F     &kp P     &kp B                &kp J     &kp L     &kp U     &kp Y     &kp SCLN
                &kp A    &kp R     &kp S     &kp T     &kp G                &kp M     &kp N     &kp E     &kp I     &td_o_fn
                &kp Z    &kp X     &kp C     &kp D     &kp V                &kp K     &kp H     &kp COMMA &kp DOT   &kp SLASH
                                   &kp TAB   &kp LGUI  &td_space_ctrl       &kp BSPC  &td_shift &kp ENTER
            >;
        };

        // ----- Layer 1: Numbers -----
        num_layer {
            bindings = <
                &kp 1    &kp 2     &kp 3     &kp 4     &kp 5                &kp 6     &kp 7     &kp 8     &kp 9     &kp 0
                &kp EXCL &kp AT    &kp HASH  &kp DLLR  &kp PERC             &kp CARET &kp AMPS  &kp ASTER &kp LPAR  &kp RPAR
                &kp MINUS &kp PLUS &kp EQUAL &kp UNDER &kp PIPE             &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &kp BSLH
                                   &trans    &trans    &trans               &trans    &trans    &trans
            >;
        };

        // ----- Layer 2: F-Keys -----
        fn_layer {
            bindings = <
                &kp F1   &kp F2    &kp F3    &kp F4    &kp F5               &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
                &kp F11  &kp F12   &kp F13   &kp F14   &kp F15              &kp F16   &kp F17   &kp F18   &kp F19   &kp F20
                &trans   &trans    &trans    &trans    &trans               &trans    &trans    &trans    &trans    &trans
                                   &trans    &trans    &trans               &trans    &trans    &trans
            >;
        };

        // ----- Layer 3: Navigation -----
        nav_layer {
            bindings = <
                &kp ESC  &kp HOME  &kp UP    &kp END   &kp PG_UP            &kp INS   &kp PSCRN &kp DEL   &macro_left &macro_right
                &kp TAB  &kp LEFT  &kp DOWN  &kp RGHT  &kp PG_DN            &kp APP   &kp VOLU  &kp MUTE  &kp VOLD   &kp CAPS
                &trans   &trans    &trans    &trans    &trans               &kp BRID  &kp BRIU  &kp MPRV  &kp MNXT   &kp MPLY
                                   &trans    &trans    &trans               &trans    &trans    &trans
            >;
        };

        // ----- Layer 4: Mouse -----
        mouse_layer {
            bindings = <
                &trans   &trans    &kp MS_UP &trans    &trans               &trans    &trans    &trans    &trans    &trans
                &trans   &kp MS_LEFT &kp MS_DOWN &kp MS_RIGHT &trans        &trans    &trans    &trans    &trans    &trans
                &trans   &trans    &kp MS_BTN1 &kp MS_BTN2 &kp MS_BTN3      &trans    &trans    &trans    &trans    &trans
                                   &trans    &trans    &trans               &trans    &trans    &trans
            >;
        };

        // ----- Layer 5: Symbols -----
        sym_layer {
            bindings = <
                &kp TILDE &kp GRAVE &kp COLON &kp DQT   &kp APOSTROP        &kp LT     &kp GT     &kp QMARK &kp EQUAL &kp PLUS
                &kp PIPE  &kp AMPS  &kp LPAR  &kp RPAR  &kp DLLR            &kp LBKT   &kp RBKT   &kp LBRC  &kp RBRC  &kp BSLH
                &kp CARET &kp PERC  &kp STAR  &kp HASH  &kp EXCL            &kp MINUS  &kp UNDERS &kp SLASH &kp COMMA &kp DOT
                                   &trans    &trans    &trans               &trans    &trans    &trans
            >;
        };

        
    };
};
