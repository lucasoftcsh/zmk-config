#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <175>;
    global-quick-tap;
    flavor = "balanced";
    tapping-term-ms = <280>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        hold_layer_tap: hold_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_LAYER_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        shift_tapdance: shift_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_TAPDANCE";
            #binding-cells = <0>;
            bindings = <&sk LEFT_SHIFT>, <&caps_word>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left-par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <1 2>;
            require-prior-idle-ms = <150>;
        };

        right-par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
            require-prior-idle-ms = <150>;
        };

        ctrl-l {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <12 11>;
        };

        ctrl-r {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <18 17>;
        };

        ctrl-shft-l {
            bindings = <&kp LS(LEFT_CONTROL)>;
            key-positions = <12 11 13>;
        };

        ctrl-shft-r {
            bindings = <&kp LS(LEFT_CONTROL)>;
            key-positions = <18 17 16>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <13 12>;
            require-prior-idle-ms = <150>;
        };

        and {
            bindings = <&kp AMPERSAND>;
            key-positions = <6 5>;
            require-prior-idle-ms = <150>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <4 3 4>;
            require-prior-idle-ms = <150>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <14 13>;
            require-prior-idle-ms = <150>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <25 24>;
            require-prior-idle-ms = <150>;
        };

        pivot {
            bindings = <&pivot>;
            key-positions = <26 27 26>;
            require-prior-idle-ms = <150>;
        };

        lalt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <0 1>;
            require-prior-idle-ms = <150>;
        };
    };

    macros {
        pivot: pivot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LEFT_ALT &kp N &kp V &kp T>;
            label = "PIVOT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
         &kp Q  &kp W  &kp E       &kp R            &kp T                          &kp Y                    &kp U    &kp I      &kp O    &kp P
         &kp A  &kp S  &kp D       &kp F            &kp G                          &kp H                    &kp J    &kp K      &kp L    &kp SEMI
&kp ESC  &kp Z  &kp X  &kp C       &kp V            &kp B                          &kp N                    &kp M    &kp COMMA  &kp DOT  &kp FSLH  &kp SQT
                       &kp DELETE  &shift_tapdance  &hold_layer_tap 1 BACKSPACE    &hold_layer_tap 2 SPACE  &kp RET  &kp LGUI
            >;
        };

        num {
            display-name = "Nav";
            bindings = <
               &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6        &kp N7          &kp N8    &kp N9     &kp N0
               &trans  &trans  &trans  &trans  &trans    &kp UP_ARROW  &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &trans
&kp LC(GRAVE)  &trans  &trans  &trans  &trans  &trans    &trans        &trans          &trans    &trans     &trans  &trans
                               &trans  &trans  &trans    &trans        &trans          &kp DOT
            >;

            label = "num";
        };

        Sym {
            display-name = "Sym";
            bindings = <
        &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp PLUS   &kp MINUS
        &trans    &trans  &trans    &trans      &trans         &kp UP_ARROW  &kp LEFT       &kp DOWN      &kp RIGHT  &trans
&trans  &trans    &trans  &trans    &trans      &trans         &trans        &trans         &trans        &trans     &trans     &kp UNDER
                          &trans    &trans      &trans         &trans        &trans         &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &bootloader  &trans  &trans  &trans  &to 0     &trans  &trans  &trans  &kp END  &kp F1
        &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &kp F10
&trans  &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &kp F20  &kp F7
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
